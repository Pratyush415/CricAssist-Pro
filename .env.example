# Copy to .env and fill in. Never put real keys in this file: it is committed.

# Which AI model answers questions: gemini (free tier) or claude.
CRICASSIST_LLM_PROVIDER=gemini
# Optional: a specific model. Defaults: gemini-3.8-flash, claude-opus-5-5.
CRICASSIST_LLM_MODEL=

# Key for the provider above (only that one is needed).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

CRICASSIST_DB_PATH=data/processed/cricassist.db
